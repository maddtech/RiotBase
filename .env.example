# ==============================================================================
# RiotBase: Band Manager - Environment Configuration
# Copy this file to .env and fill in your values before running Docker Compose.
# ==============================================================================

# [REQUIRED] Secret key used to sign JWT session tokens.
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# [DATABASE] Directory for SQLite persistence inside the container (default: /data)
DATA_DIR=/data

# [DATABASE] Connection string. Defaults to SQLite WAL mode inside DATA_DIR.
# For PostgreSQL, use: postgresql+psycopg://user:password@host:5432/riotbase
DATABASE_URL=sqlite:////data/app.db

# [SERVER] Uvicorn worker count.
# IMPORTANT: Keep WORKERS=1 when using SQLite. Increase (e.g., 2-4) only for PostgreSQL.
WORKERS=1

# [AUTH] Allow public self-registration without an invite link (true/false).
# Can also be toggled at runtime in Sync & Settings.
ALLOW_PUBLIC_SIGNUP=false

# [OPTIONAL - BYOK] Google Places API key for Tier 3 venue autocomplete fallback.
# Can also be configured at runtime in Sync & Settings.
GOOGLE_PLACES_API_KEY=

# [OPTIONAL - BYOK] Outbound SMTP configuration for event reminders & password resets.
# Can also be configured at runtime in Sync & Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=